# Copy to .env.protondrive.local (gitignored) and fill real values:
#   cp .env.protondrive.local.example .env.protondrive.local
#   chmod 600 .env.protondrive.local
#
# Never commit .env.protondrive.local. Prefer encrypting backups (DSMENC1)
# before upload. Log into Proton Drive in a browser once so account keys exist.
#
# Install rclone with the protondrive backend: https://rclone.org/install/
# Optional: `rclone config` and create a remote named DSM_PROTONDRIVE_REMOTE
# instead of (or in addition to) username/password below.

DSM_PROTONDRIVE_REMOTE=protondrive
DSM_PROTONDRIVE_PATH=db-storage-manager-backups
DSM_PROTONDRIVE_RCLONE=rclone

# Account credentials (required unless an rclone protondrive remote already exists)
DSM_PROTONDRIVE_USERNAME=
DSM_PROTONDRIVE_PASSWORD=

# Optional 2FA: either a one-shot code, or the TOTP secret for automation
# DSM_PROTONDRIVE_2FA=
# DSM_PROTONDRIVE_OTP_SECRET=

# Two-password Proton accounts only
# DSM_PROTONDRIVE_MAILBOX_PASSWORD=

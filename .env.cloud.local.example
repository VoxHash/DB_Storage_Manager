# Copy to .env.cloud.local (gitignored), or run:
#   ./scripts/setup-cloud-env.sh
#   chmod 600 .env.cloud.local   # script sets mode 600
#
# Never commit .env.cloud.local. Prefer vendor default credential chains
# (aws configure / gcloud ADC / az login) over pasting long-lived keys here.
# Non-secret defaults can also live under SecureStore settings key
# cloud_managed (aws / gcp / azure).
#
# Optional extras:
#   pip install -e ".[aws]"     # boto3 (also a core dep)
#   pip install -e ".[gcp]"     # google-cloud-sql + connector
#   pip install -e ".[azure]"   # azure-identity + azure-mgmt-sql
#   pip install -e ".[cloud]"   # all of the above

# --- AWS RDS (default chain: ~/.aws/credentials, env, instance role, SSO) ---
DSM_AWS_REGION=us-east-1
# DSM_AWS_PROFILE=default
# Prefer leaving these empty and using `aws configure` / SSO / IAM role:
# DSM_AWS_ACCESS_KEY_ID=
# DSM_AWS_SECRET_ACCESS_KEY=
# DSM_AWS_SESSION_TOKEN=
# Path to RDS CA bundle for sslmode=verify-full / IAM auth:
# DSM_AWS_RDS_SSL_CA=/path/to/global-bundle.pem

# --- GCP Cloud SQL (ADC: gcloud auth application-default login) ---
# DSM_GCP_PROJECT_ID=my-gcp-project
# DSM_GCP_CREDENTIALS=/path/to/service-account.json
# (or export GOOGLE_APPLICATION_CREDENTIALS / GOOGLE_CLOUD_PROJECT)

# --- Azure SQL (DefaultAzureCredential: az login / managed identity) ---
# DSM_AZURE_SUBSCRIPTION_ID=
# DSM_AZURE_TENANT_ID=
# DSM_AZURE_CLIENT_ID=
# DSM_AZURE_CLIENT_SECRET=
